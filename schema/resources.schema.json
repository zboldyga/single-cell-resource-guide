{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zboldyga/single-cell-resource-guide/main/schema/resources.schema.json",
  "title": "Single-Cell Resource Guide catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "updated_at",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "url",
          "purpose",
          "question",
          "categories",
          "modalities",
          "species",
          "biological_scope",
          "granularity",
          "resource_type",
          "maintainer",
          "scale",
          "release",
          "access",
          "licensing",
          "not_for",
          "sources",
          "verification",
          "related",
          "key_data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://[^\\s<>]+$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "categories": {
            "type": "array",
            "items": {
              "enum": [
                "Expression & cell atlases",
                "Perturbation & dependencies",
                "Genes & genomes",
                "Proteins & structures",
                "Pathways & interactions",
                "Regulation & epigenomics",
                "Disease & drug discovery",
                "Archives & standards"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "modalities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "species": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "biological_scope": {
            "type": "string",
            "minLength": 1
          },
          "granularity": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "resource_type": {
            "enum": [
              "primary",
              "aggregator",
              "standard",
              "tool"
            ]
          },
          "maintainer": {
            "type": "string",
            "minLength": 1
          },
          "scale": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary",
              "as_of",
              "source_url"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "as_of": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_url": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://[^\\s<>]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "release": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "date",
              "source_url",
              "note"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_url": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://[^\\s<>]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "access": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "web",
              "api",
              "bulk"
            ],
            "properties": {
              "web": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "url",
                  "note"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "yes",
                      "no",
                      "unknown",
                      "not_applicable"
                    ]
                  },
                  "url": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https?://[^\\s<>]+$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "yes"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri",
                          "pattern": "^https?://[^\\s<>]+$"
                        }
                      }
                    }
                  }
                ]
              },
              "api": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "url",
                  "note"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "yes",
                      "no",
                      "unknown",
                      "not_applicable"
                    ]
                  },
                  "url": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https?://[^\\s<>]+$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "yes"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri",
                          "pattern": "^https?://[^\\s<>]+$"
                        }
                      }
                    }
                  }
                ]
              },
              "bulk": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "url",
                  "note"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "yes",
                      "no",
                      "unknown",
                      "not_applicable"
                    ]
                  },
                  "url": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https?://[^\\s<>]+$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "yes"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri",
                          "pattern": "^https?://[^\\s<>]+$"
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "download_examples": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "description", "command", "requirements", "source_url", "checked_on"],
              "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 120 },
                "description": { "type": "string", "minLength": 1, "maxLength": 1200 },
                "command": { "type": "string", "minLength": 1, "maxLength": 8000 },
                "requirements": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 1200 } },
                "source_url": { "type": "string", "format": "uri", "pattern": "^https?://[^\\s<>]+$" },
                "checked_on": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
              }
            }
          },
          "licensing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary",
              "source_url"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "source_url": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://[^\\s<>]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "not_for": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "title",
                "type",
                "checked_on",
                "supports"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://[^\\s<>]+$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "official",
                    "paper"
                  ]
                },
                "checked_on": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "supports": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z_]+(?:\\.[a-z_]+)*$"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              }
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "checked_on",
              "note"
            ],
            "properties": {
              "status": {
                "enum": [
                  "verified",
                  "provisional"
                ]
              },
              "checked_on": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "key_data": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verification": {
                  "properties": {
                    "status": {
                      "const": "verified"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "verification": {
                  "properties": {
                    "checked_on": {
                      "type": "string",
                      "format": "date",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
